# Referencia de configuracion: los notebooks no cargan este archivo automaticamente.
# Definir estas variables en la terminal antes de iniciar Jupyter.
# El archivo de credenciales debe estar fuera del repositorio.
GOOGLE_APPLICATION_CREDENTIALS=C:/Users/TU_USUARIO/.config/pi/firebase-service-account.json
GOOGLE_CLOUD_PROJECT=tu-proyecto-de-pruebas

# Carpeta para la carga local y el monitor; relativa a la terminal que inicia Jupyter.
# Si no se define, ambos notebooks usan Dashboard/csv desde esa carpeta de trabajo.
PI_CSV_DIR=Dashboard/csv
